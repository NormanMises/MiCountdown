<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="315"
                android:startColor="@color/glass_top"
                android:centerColor="@color/glass_center"
                android:endColor="@color/glass_bottom" />
            <stroke android:width="1dp" android:color="@color/glass_rim" />
        </shape>
    </item>
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="23dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/glass_sheen"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
