<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base: near-opaque surface so text stays readable on any wallpaper. -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient
                android:angle="270"
                android:startColor="@color/card_top"
                android:endColor="@color/card_bottom" />
            <stroke android:width="1dp" android:color="@color/card_rim" />
        </shape>
    </item>
    <!-- Soft wash of the icon's blue from the top-right corner. -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient
                android:angle="225"
                android:startColor="@color/card_glow"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
