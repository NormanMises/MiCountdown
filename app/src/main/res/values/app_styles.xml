<resources>
    <style name="AppTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/widget_primary</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="AppBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:textColor">@color/widget_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="AppButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>

    <style name="AppButton.Primary">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">@color/app_on_accent</item>
    </style>

    <style name="AppButton.Text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:background">@drawable/button_text</item>
        <item name="android:textColor">@color/widget_accent</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
