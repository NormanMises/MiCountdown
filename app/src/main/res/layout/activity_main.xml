<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/AppTitle"
            android:text="最近倒数日" />

        <TextView
            style="@style/AppBody"
            android:layout_marginTop="6dp"
            android:text="把小米日历里最近的一个倒数日放到桌面上" />

        <!-- The widget itself, enlarged: the same layout and styles as on the
             home screen, scaled up in code. -->
        <FrameLayout
            android:id="@+id/stage"
            android:layout_width="252dp"
            android:layout_height="252dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:clipChildren="false">

            <include
                layout="@layout/widget_card"
                android:layout_width="168dp"
                android:layout_height="168dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <!-- Shown when GitHub has a newer release. -->
        <LinearLayout
            android:id="@+id/update"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/dot" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/update_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/widget_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/update_detail"
                    style="@style/AppBody"
                    android:layout_marginTop="2dp"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/update_download"
                style="@style/AppButton.Text"
                android:text="下载" />
        </LinearLayout>

        <!-- Every upcoming countdown; a repeating one appears once, at its next date. -->
        <LinearLayout
            android:id="@+id/list_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/list_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.01"
                android:textColor="@color/widget_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/surface"
                android:divider="@drawable/divider"
                android:orientation="vertical"
                android:showDividers="middle" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/permission_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/surface"
            android:orientation="horizontal"
            android:padding="16dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_shield" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/widget_primary"
                    android:textSize="15sp"
                    android:text="只读取日历" />

                <TextView
                    style="@style/AppBody"
                    android:layout_marginTop="4dp"
                    android:textSize="13sp"
                    android:text="只申请「读取日历」这一项权限，用来找到最近的倒数日。除了检查更新不联网，不收集任何数据。" />

                <TextView
                    style="@style/AppBody"
                    android:layout_marginTop="8dp"
                    android:textSize="13sp"
                    android:textColor="@color/widget_primary"
                    android:text="授权时请选择「始终允许」。选「仅在使用中允许」的话，小部件在后台刷新时会读不到日历。" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="32dp" />

        <Button
            android:id="@+id/primary"
            style="@style/AppButton.Primary" />

        <LinearLayout
            android:id="@+id/secondary_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/installed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/widget_secondary"
                android:textSize="15sp"
                android:text="✓ 已在桌面"
                android:visibility="gone" />

            <Button
                android:id="@+id/secondary"
                style="@style/AppButton.Text" />
        </LinearLayout>

        <TextView
            android:id="@+id/footnote"
            style="@style/AppBody"
            android:layout_marginTop="12dp"
            android:textSize="12sp"
            android:text="打开本页时会刷新小部件；之后系统约每 30 分钟自动刷新一次。" />
    </LinearLayout>
</ScrollView>
