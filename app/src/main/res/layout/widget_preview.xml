<!-- Shown in the launcher's widget picker on Android 12+. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout style="@style/WidgetCard">

        <LinearLayout style="@style/WidgetHeaderRow">
            <ImageView style="@style/WidgetDot" />
            <TextView
                style="@style/WidgetHeader"
                android:text="1月1日 周五" />
        </LinearLayout>

        <TextView
            style="@style/WidgetTitle"
            android:text="元旦" />

        <!-- Mirrors the real widget: a large number and a small accent unit
             (0.42 × 48sp), which a plain string cannot express. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.15"
            android:gravity="bottom|start"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:letterSpacing="-0.03"
                android:textColor="@color/widget_number"
                android:textSize="48sp"
                android:text="36" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="3dp"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/widget_accent"
                android:textSize="20sp"
                android:text="天" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
