<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card"
    style="@style/WidgetCard">

    <LinearLayout style="@style/WidgetHeaderRow">
        <ImageView style="@style/WidgetDot" />
        <TextView
            android:id="@+id/date"
            style="@style/WidgetHeader"
            android:text="最近倒数日" />
    </LinearLayout>

    <TextView
        android:id="@+id/title"
        style="@style/WidgetTitle"
        android:text="正在读取…" />

    <TextView
        android:id="@+id/days"
        style="@style/WidgetDays" />

    <TextView
        android:id="@+id/hint"
        style="@style/WidgetHint" />
</LinearLayout>
